# SmartRoute AI — Backend Environment Variables
# -----------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ── OpenRouteService ─────────────────────────────
# Sign up free at https://openrouteservice.org/dev/#/signup
# Then copy your token from: https://openrouteservice.org/dev/#/home
ORS_API_KEY=your_openrouteservice_api_key_here

# ── Server ────────────────────────────────────────
PORT=5000

# ── CORS: comma-separated list of allowed origins ─
# Example: http://localhost:5173,http://localhost:4173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
